# Shared by PostgreSQL and the production app. Change the password before starting.
POSTGRES_USER=ductcalc
POSTGRES_PASSWORD=super-secret-change-me
POSTGRES_DB=ductcalc
POSTGRES_HOSTNAME=db

# Compose settings. Use a different project name and port for each installation.
COMPOSE_PROJECT_NAME=ductcalc
DUCTCALC_BIND_ADDRESS=127.0.0.1
DUCTCALC_PORT=8080

# Local tag for source builds. To use a published image instead, set this to
# ghcr.io/m-housh/ductcalc:latest and follow docs/self-hosting.md.
DUCTCALC_IMAGE=localhost/ductcalc:latest

# The production environment uses PostgreSQL. SQLITE_PATH only applies when
# starting the app with --env development, as `just run` does.

# PDF tools are installed in the container images. Override only when replacing
# the executables or PDF engine in a custom image.
#PDF_ENGINE=weasyprint
#PANDOC_PATH=/usr/bin/pandoc
#PDFTOTEXT_PATH=/usr/bin/pdftotext
